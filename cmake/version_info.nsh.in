; Generated by cmake/win32_rc.cmake from cmake/version_info.nsh.in: the version
; resource of the executables (cmake/version_resource.rc.in), for the
; installer. packaging/windows/logsquirl.nsi includes it, so setup.exe names
; the same product, version, company and copyright as the programs it
; installs (#445).
!define PRODUCT_VI_NAME "@PRODUCT_BUNDLE@"
!define PRODUCT_VI_COMPANY "@PRODUCT_COMPANY_NAME@"
!define PRODUCT_VI_COPYRIGHT "@PRODUCT_COMPANY_COPYRIGHT@"
!define PRODUCT_VI_VERSION "@PRODUCT_VERSION_MAJOR@.@PRODUCT_VERSION_MINOR@.@PRODUCT_VERSION_PATCH@.@PRODUCT_VERSION_REVISION@"
