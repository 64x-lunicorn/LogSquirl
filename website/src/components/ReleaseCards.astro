---
// The home page's release cards, generated from the release pages (#313):
// the latest stable release, a newer beta and a card for all releases. The
// release overview lists them in ReleaseTimeline.astro.
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { currentReleases, readReleases } from '../releases.mjs';

const { stable, beta } = currentReleases(readReleases());
const href = (release) => `/${release.slug}/`;

const cards = [
  stable && { title: stable.label, description: `Stable release — ${stable.description}`, href: href(stable) },
  beta && { title: beta.label, description: `Beta — ${beta.description}`, href: href(beta) },
  { title: 'All Releases', description: 'View all release notes and download links.', href: '/news/' },
].filter(Boolean);
---

<CardGrid>
  {cards.map((card) => <LinkCard title={card.title} description={card.description} href={card.href} />)}
</CardGrid>
