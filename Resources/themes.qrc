<RCC>
    <qresource prefix="/themes">
        <file alias="dark.qss">themes/dark.qss</file>
        <file alias="fusion-light.qss">themes/fusion-light.qss</file>
        <file alias="high-contrast.qss">themes/high-contrast.qss</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="close-dark.svg">icons/close-dark.svg</file>
        <file alias="close-light.svg">icons/close-light.svg</file>
    </qresource>
</RCC>
