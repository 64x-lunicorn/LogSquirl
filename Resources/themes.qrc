<RCC>
    <qresource prefix="/icons">
        <file alias="close-dark.svg">icons/close-dark.svg</file>
        <file alias="close-light.svg">icons/close-light.svg</file>
        <file alias="check-dark.svg">icons/check-dark.svg</file>
        <file alias="check-light.svg">icons/check-light.svg</file>
        <file alias="check-hc.svg">icons/check-hc.svg</file>
        <file alias="check-disabled-light.svg">icons/check-disabled-light.svg</file>
        <file alias="check-disabled-dark.svg">icons/check-disabled-dark.svg</file>
        <file alias="check-disabled-hc.svg">icons/check-disabled-hc.svg</file>
        <file alias="dash-light.svg">icons/dash-light.svg</file>
        <file alias="dash-dark.svg">icons/dash-dark.svg</file>
        <file alias="dash-hc.svg">icons/dash-hc.svg</file>
        <file alias="dash-disabled-light.svg">icons/dash-disabled-light.svg</file>
        <file alias="dash-disabled-dark.svg">icons/dash-disabled-dark.svg</file>
        <file alias="dash-disabled-hc.svg">icons/dash-disabled-hc.svg</file>
        <file alias="arrow-down-dark.svg">icons/arrow-down-dark.svg</file>
        <file alias="arrow-up-dark.svg">icons/arrow-up-dark.svg</file>
        <file alias="arrow-down-light.svg">icons/arrow-down-light.svg</file>
        <file alias="arrow-down-hc.svg">icons/arrow-down-hc.svg</file>
        <file alias="arrow-up-light.svg">icons/arrow-up-light.svg</file>
        <file alias="arrow-up-hc.svg">icons/arrow-up-hc.svg</file>
    </qresource>
</RCC>
