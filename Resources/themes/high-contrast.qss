/*
 * LogSquirl — High Contrast Theme (dark variant)
 *
 * This file is part of LogSquirl.
 * SPDX-License-Identifier: GPL-3.0-or-later
 *
 * Palette colours are applied in C++ (see styles.cpp).
 * This stylesheet covers widget-level styling only.
 *
 * Follows WCAG AAA contrast where possible and the Windows
 * "Contrast Themes" conventions (pure colours, 2px borders,
 * yellow = selection / focus, red = destructive).
 *
 * ---------------------------------------------------------------
 *  Palette reference — keep in sync with the values used below
 * ---------------------------------------------------------------
 *  Surfaces
 *    base / content ................... #000000
 *    panel / tab bar .................. #000000
 *    button ........................... #000000
 *    button hover ..................... #1F1F1F
 *    button pressed ................... #FFFF00   (inverted)
 *    tab hover ........................ #1F1F1F
 *    scrollbar track .................. #000000
 *
 *  Borders
 *    regular (all 2px) ................ #FFFFFF
 *    disabled ......................... #808080
 *
 *  Text
 *    disabled ......................... #A6A6A6
 *    inverted (on accent) ............. #000000
 *    tooltip .......................... #FFFF00
 *
 *  Accent
 *    primary (focus / selection) ...... #FFFF00
 *
 *  Misc
 *    scrollbar handle ................. #FFFFFF
 *    scrollbar handle hover ........... #FFFF00
 *    tooltip bg ....................... #000000
 *    close-button hover ............... #FF0000
 *    separator ........................ #FFFFFF
 * ---------------------------------------------------------------
 */


/* ===========================================================
 *  Push buttons
 * =========================================================== */
QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    padding: 3px 11px;          /* slightly trimmed to compensate 2px border */
}
QPushButton:hover    { border-color: #FFFF00; }
QPushButton:pressed  {
    background-color: #FFFF00;
    border-color: #FFFF00;
    color: #000000;
}
QPushButton:focus    { border-color: #FFFF00; }
QPushButton:disabled {
    background-color: #000000;
    border-color: #808080;
    color: #A6A6A6;
}


/* ===========================================================
 *  Tool buttons
 * =========================================================== */
QToolButton {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 3px;
    padding: 2px;               /* trimmed to compensate 2px border */
}
QToolButton:hover {
    background-color: #1F1F1F;
    border-color: #FFFF00;
}
QToolButton:pressed {
    background-color: #FFFF00;
    border-color: #FFFF00;
    color: #000000;
}
QToolButton:checked {
    background-color: #FFFF00;
    border-color: #FFFF00;
    color: #000000;
}
QToolButton:focus {
    border-color: #FFFF00;
}


/* ===========================================================
 *  Text inputs & combo boxes
 *  Base rule gives them a 2px border so :focus only changes
 *  the colour — no layout shift on focus.
 * =========================================================== */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    padding: 2px 5px;
}
QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #FFFF00;
}
QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #000000;
    border-color: #808080;
    color: #A6A6A6;
}


/* ===========================================================
 *  Tabs (QTabWidget / QTabBar)
 * =========================================================== */
QTabWidget::pane {
    background: #000000;
    border: 2px solid #FFFFFF;
    top: -2px;                  /* match 2px border to avoid double line */
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: 2px solid transparent;  /* reserve space → no wiggle on select */
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 4px 4px;
    margin-right: 0px;
}
QTabBar::tab:hover:!selected {
    background-color: #1F1F1F;
    border-color: #FFFF00;
    border-bottom-color: transparent;
}
QTabBar::tab:selected {
    background-color: #000000;
    border-bottom-color: #FFFF00;
}

QTabBar::close-button {
    image: url(:/icons/close-dark.svg);
    width: 24px;
    height: 24px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    margin-right: 6px;
    border-radius: 2px;
}
QTabBar::close-button:hover {
    background-color: #FF0000;
}

/*
 *  "New tab" (+) button — requires:
 *  addTabButton->setObjectName("tabAddButton");
 */
QToolButton#tabAddButton {
    background-color: transparent;
    border: 2px solid transparent;
    border-radius: 3px;
    font-size: 14px;
    font-weight: bold;
    padding: 0 6px;
    margin: 2px 4px;
    min-width: 20px;
    min-height: 18px;
    max-height: 22px;
    color: #FFFFFF;
}
QToolButton#tabAddButton:hover {
    background-color: #1F1F1F;
    border-color: #FFFF00;
    color: #FFFF00;
}
QToolButton#tabAddButton:pressed {
    background-color: #000000;
    border-color: #FFFFFF;
}


/* ===========================================================
 *  Scroll bars
 * =========================================================== */
QScrollBar:vertical {
    background: #000000;
    width: 14px;
    margin: 0;
    border: 1px solid #FFFFFF;
}
QScrollBar::handle:vertical {
    background: #FFFFFF;
    border-radius: 3px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #FFFF00;
}

QScrollBar:horizontal {
    background: #000000;
    height: 14px;
    margin: 0;
    border: 1px solid #FFFFFF;
}
QScrollBar::handle:horizontal {
    background: #FFFFFF;
    border-radius: 3px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #FFFF00;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    border: none;
    background: none;
}


/* ===========================================================
 *  Tooltips
 * =========================================================== */
QToolTip {
    background-color: #000000;
    color: #FFFF00;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    padding: 4px;
}


/* ===========================================================
 *  Menus
 * =========================================================== */
QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 4px 0;
}
QMenu::item {
    padding: 5px 24px;
}
QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
}
QMenu::separator {
    height: 1px;
    background: #FFFFFF;
    margin: 4px 8px;
}


/* ===========================================================
 *  Group boxes
 * =========================================================== */
QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}


/* ===========================================================
 *  Dock widgets & status bar
 * =========================================================== */
QDockWidget::title {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    padding: 4px;
}

QStatusBar {
    border-top: 2px solid #FFFFFF;
}
QStatusBar::item {
    border: none;
}
