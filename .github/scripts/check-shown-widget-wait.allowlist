tests/benchmarks/tableview_scroll_benchmark.cpp
tests/benchmarks/textview_ansi_benchmark.cpp
tests/benchmarks/textview_scroll_benchmark.cpp
tests/benchmarks/textview_valuenames_benchmark.cpp
